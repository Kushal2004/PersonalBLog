---
import type { HTMLTag } from "astro/types";
import type { CollectionEntry } from "astro:content";
import { getPostSortDate } from "@/data/post";
import FormattedDate from "../FormattedDate.astro";
interface Props {
	as?: HTMLTag;
	post: CollectionEntry<"post">;
	withDesc?: boolean;
}
const { as: Tag = "h3", post, withDesc = false }: Props = Astro.props;
---

<a class="post-list-card" href={`/posts/${post.slug}/`} data-astro-prefetch>
	<div>
		<Tag class="post-list-title">{post.data.draft && <span>Draft · </span>}{post.data.title}</Tag>
		{withDesc && <p>{post.data.description}</p>}
		<FormattedDate class="post-list-date" date={getPostSortDate(post)} />
	</div>
	<svg
		class="reading-arrow"
		aria-hidden="true"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"><path d="m9 5 7 7-7 7"></path></svg
	>
</a>
