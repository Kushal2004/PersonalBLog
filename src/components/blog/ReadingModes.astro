---
import type { CollectionEntry } from "astro:content";
import Flashcards from "./Flashcards.astro";
import { getReadingEntries } from "@/data/reading";
import "../../styles/reading.css";
interface Props {
	posts: CollectionEntry<"post">[];
}
const entries = getReadingEntries(Astro.props.posts);
const tags = [...new Set(entries.flatMap((entry) => entry.tags))].sort();
const sections: { title: string; entries: typeof entries }[] = [];
for (const entry of entries) {
	const last = sections[sections.length - 1];
	if (last?.title === entry.section) last.entries.push(entry);
	else sections.push({ title: entry.section, entries: [entry] });
}
const modes = [
	{ id: "index", title: "Field index", description: "Find one term quickly" },
	{ id: "book", title: "Book chapters", description: "Read the ideas in order" },
	{ id: "flashcards", title: "Flashcards", description: "Swipe, sort, and review" },
];
---

<section class="reading" aria-labelledby="reading-title" data-reading>
	<div class="reading-section-heading">
		<h2 id="reading-title">Latest posts</h2>
		<a class="text-link" href="/posts/">See all posts</a>
	</div>
	<p class="reading-introduction">Choose how you want to read.</p>
	<div
		class="reading-choices"
		data-reading-controls
		hidden
		role="group"
		aria-label="Reading experience"
	>
		{
			modes.map((mode) => (
				<button
					type="button"
					data-reading-mode={mode.id}
					aria-controls={`reading-${mode.id}`}
					aria-pressed={mode.id === "index" ? "true" : "false"}
					title={mode.description}
				>
					{mode.title}
					<span class="sr-only"> — {mode.description}</span>
				</button>
			))
		}
	</div>
	<p class="sr-only" data-reading-status aria-live="polite"></p>
	<noscript
		><p>
			Browse the index and chapters below. Enable JavaScript to study with interactive flashcards.
		</p></noscript
	>
	<div data-reading-panels>
		<section
			id="reading-index"
			class="reading-panel"
			data-reading-panel="index"
			aria-labelledby="index-title"
		>
			<h3 id="index-title" class="sr-only">Field index</h3>
			<div class="reading-filters" data-index-controls hidden>
				<label class="reading-search"
					><span class="sr-only">Find a term</span><input
						name="term"
						type="search"
						data-index-search
						autocomplete="off"
						placeholder="Find a term…"
					/></label
				>
				<label
					><span class="sr-only">Topic</span><select name="topic" data-index-topic
						><option value="">All topics</option>{
							tags.map((tag) => <option value={tag}>{tag}</option>)
						}</select
					></label
				>
				<label
					><span class="sr-only">Sort</span><select name="sort" data-index-sort
						><option value="curated">Reading order</option><option value="az">A–Z by title</option
						></select
					></label
				>
			</div>
			<p class="reading-count" data-index-count aria-live="polite" hidden></p>
			<div class="reading-index" data-index-grid>
				{
					entries.map((entry) => (
						<a
							class="reading-note"
							data-index-entry
							data-term={entry.term}
							data-tags={JSON.stringify(entry.tags)}
							href={entry.href}
							data-astro-prefetch
						>
							<div class="reading-note-copy">
								<>
									<h4>{entry.term}</h4>
									<p>{entry.summary}</p>
								</>
							</div>
							<svg
								class="reading-arrow"
								aria-hidden="true"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<path d="m9 5 7 7-7 7" />
							</svg>
						</a>
					))
				}
			</div>
			<p class="reading-empty" data-index-empty hidden>
				No notes match. Try another term or choose all topics.
			</p>
			{
				!entries.length && (
					<p class="reading-empty">Published posts will appear here when you add them.</p>
				)
			}
		</section>
		<section
			id="reading-book"
			class="reading-panel"
			data-reading-panel="book"
			aria-labelledby="book-title"
		>
			<div class="reading-heading">
				<h3 id="book-title">Book chapters</h3><span>{entries.length} chapters</span>
			</div>
			<p class="reading-description">Read from the beginning, or choose a chapter.</p>
			{
				sections.map((section) => (
					<div class="reading-part">
						{sections.length > 1 && <h4 class="reading-part-title">{section.title}</h4>}
						<ol>
							{section.entries.map((entry) => (
								<li>
									<a class="reading-chapter" href={entry.href} data-astro-prefetch>
										<span class="reading-chapter-number">{entry.number}</span>
										<div>
											<h5>{entry.title}</h5>
											<p>{entry.summary}</p>
										</div>
										<svg
											class="reading-arrow"
											aria-hidden="true"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
										>
											<path d="m9 5 7 7-7 7" />
										</svg>
									</a>
								</li>
							))}
						</ol>
					</div>
				))
			}
			{!entries.length && <p class="reading-empty">Published posts will become your chapters.</p>}
		</section>
		<section
			id="reading-flashcards"
			class="reading-panel"
			data-reading-panel="flashcards"
			aria-labelledby="flashcards-title"
		>
			<Flashcards entries={entries} />
		</section>
	</div>
</section>
<script>
	import "../../scripts/reading-modes";
</script>
