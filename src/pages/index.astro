---
import ReadingModes from "@/components/blog/ReadingModes.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
const posts = await getAllPosts();
---

<PageLayout meta={{ title: "Home" }}>
	<section class="home-introduction" aria-labelledby="welcome-title">
		<h1 id="welcome-title">Hi I am Kushal ! 👋</h1>
		<div class="home-copy">
			<p>
				Welcome to my blog! Here, I'll be sharing everything I’m passionate about, from the latest
				in web development and digital security to personal projects and insights from my journey as
				a Computer Science student.
			</p>
			<p>
				Stay tuned for new content, and feel free to explore the different sections of my blog. Your
				feedback and interaction are always welcome, so don’t hesitate to leave comments or get in
				touch through the contact form.
			</p>
			<p>I’m excited to have you along on this journey!</p>
		</div>
	</section>
	<ReadingModes posts={posts} />
	<section class="home-connect" aria-labelledby="connect-title">
		<h2 id="connect-title">Let's Connect</h2>
		<p>
			If you want to get in touch with me about something or just to say hi, reach out on social
			media or check out my personal website.
		</p>
		<nav class="social-links" aria-label="Find Kushal online">
			<a href="https://portfolio-kushal.vercel.app/" target="_blank" rel="noopener noreferrer"
				>Portfolio</a
			><span aria-hidden="true">/</span>
			<a href="https://github.com/Kushal2004" target="_blank" rel="noopener noreferrer">GitHub</a
			><span aria-hidden="true">/</span>
			<a href="https://linkedin.com/in/k-kushal/" target="_blank" rel="noopener noreferrer"
				>LinkedIn</a
			><span aria-hidden="true">/</span>
			<a href="mailto:kuchibhotlakushal2004@gmail.com">Email</a>
		</nav>
	</section>
</PageLayout>
