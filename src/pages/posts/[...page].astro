---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
export const getStaticPaths = (async ({ paginate }) => {
	const posts = sortMDByDate(await getAllPosts());
	return paginate(posts, { pageSize: 10, props: { uniqueTags: getUniqueTags(posts) } });
}) satisfies GetStaticPaths;
interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
}
const { page, uniqueTags } = Astro.props;
const grouped = groupPostsByYear(page.data);
const years = Object.keys(grouped).sort((a, b) => +b - +a);
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Previous page", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Next page →", url: page.url.next } }),
};
---

<PageLayout meta={{ title: "Blog", description: "Notes, projects, and things I’m learning." }}>
	<h1 class="title">Blog</h1>
	<nav class="post-topics" aria-label="Browse topics">
		{
			uniqueTags.map((tag) => (
				<a class="text-link" href={`/tags/${tag}/`}>
					{tag}
				</a>
			))
		}
	</nav>
	<section aria-label="Blog post list">
		{
			years.map((year) => (
				<section class="post-year" aria-label={`Posts from ${year}`}>
					<h2>{year}</h2>
					<ul>
						{grouped[year]?.map((post) => (
							<li>
								<PostPreview post={post} withDesc />
							</li>
						))}
					</ul>
				</section>
			))
		}
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
